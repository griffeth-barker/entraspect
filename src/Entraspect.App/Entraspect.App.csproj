<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The logo artwork lives in the repository's assets folder; the app uses two of its variants. -->
    <AvaloniaResource Include="..\..\assets\entraspect-icon-square.png" Link="Assets\entraspect-icon-square.png" />
    <AvaloniaResource Include="..\..\assets\entraspect-icon-with-lettermark-cropped-xp.png"
                      Link="Assets\entraspect-icon-with-lettermark-cropped-xp.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Entraspect.Core\Entraspect.Core.csproj" />
    <ProjectReference Include="..\Entraspect.Graph\Entraspect.Graph.csproj" />
  </ItemGroup>
</Project>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             xmlns:views="using:Entraspect.App.Views"
             x:Class="Entraspect.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">
    <ScrollViewer>
        <!-- Fills the width up to a maximum, aligned left. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="820" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="8">
            <!-- The logo with its lettermark is the page heading, so there is no "About entraspect" title.
                 Transparent background; 1095 x 228 pixels, shown 64 high. -->
            <Image Source="/Assets/entraspect-icon-with-lettermark-cropped-xp.png" Height="64"
                   HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,4"
                   AutomationProperties.Name="entraspect"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="{Binding DescriptionText}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Classes="muted" />

            <ContentControl Content="{Binding ExcessPermissions}" IsVisible="{Binding IsConnected}" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="App data folder" Classes="sectionTitle" Margin="0" />
                <views:InfoTip Text="Connection profiles and settings are saved here. Passwords are never saved." />
            </StackPanel>
            <SelectableTextBlock Text="{Binding AppDataFolder}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open settings.json" Command="{Binding OpenSettingsFileCommand}" />
                <Button Content="Reload" Command="{Binding ReloadSettingsCommand}" />
                <views:InfoTip Text="Edit settings in a text editor, save, then select Reload. entraspect saves this file whenever you change a setting here, which replaces edits you haven't reloaded, so reload first. Passwords are never saved." />
            </StackPanel>
            <TextBlock Text="{Binding SettingsStatusText}" Classes="muted"
                       IsVisible="{Binding SettingsStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding SettingsErrorText}" Classes="error"
                       IsVisible="{Binding SettingsErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

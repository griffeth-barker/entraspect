<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             xmlns:views="using:Entraspect.App.Views"
             x:Class="Entraspect.App.Views.CheckPageView"
             x:DataType="vm:CheckPageViewModel">
    <UserControl.Styles>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <ContentControl Content="{Binding Banner}" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Classes="pageTitle" />
                <views:InfoTip Text="{Binding Description}" />
            </StackPanel>

            <views:ScanBar />

            <!-- Why the page is empty; how the check last ran is in the status bar. -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="!IsLicensed" />
                        <Binding Path="IsDisabled" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <TextBlock Text="{Binding NotAvailableText}" Classes="muted" IsVisible="{Binding !IsLicensed}" />
                <TextBlock Text="{x:Static vm:CheckPageViewModel.DisabledText}" Classes="muted"
                           IsVisible="{Binding IsDisabled}" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorText}" Classes="error"
                       IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Search and filters, like the Entra admin center lists. -->
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox Text="{Binding SearchText}" Width="260" Margin="0,0,8,4" PlaceholderText="Search" />
                <Button x:Name="AddFilterButton" Command="{Binding AddFilterCommand}" Margin="0,0,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="+" FontWeight="SemiBold" />
                        <TextBlock Text="Add filter" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding ActiveFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActiveFilter">
                            <Border Classes="filterPill" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding DisplayText}" Classes="pillText"
                                            Command="{Binding $parent[UserControl].((vm:CheckPageViewModel)DataContext).EditFilterCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Edit filter" />
                                    <Button Content="✕" Classes="pillText"
                                            Command="{Binding $parent[UserControl].((vm:CheckPageViewModel)DataContext).RemoveFilterCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Remove filter" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Reset filters" Command="{Binding ResetFiltersCommand}" Classes="pillText"
                        IsVisible="{Binding HasActiveFilters}" Margin="0,0,8,4" />
                <TextBlock Text="{Binding FilterSummary}" VerticalAlignment="Center" Classes="muted" Margin="4,0,0,4" />
            </WrapPanel>

            <Popup IsOpen="{Binding IsFilterEditorOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding #AddFilterButton}"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True">
                <Border Padding="12" CornerRadius="8" BorderThickness="1" MinWidth="260"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" />

                        <!-- Step 1: pick the property to filter on. -->
                        <ItemsControl ItemsSource="{Binding FilterFields}" IsVisible="{Binding IsChoosingField}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterField">
                                    <Button Content="{Binding Name}" Classes="menuItem"
                                            Command="{Binding $parent[UserControl].((vm:CheckPageViewModel)DataContext).ChooseFieldCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Step 2: pick values, or type text. -->
                        <ItemsControl ItemsSource="{Binding EditorChoices}" IsVisible="{Binding IsEditingChoice}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterChoice">
                                    <CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="4" IsVisible="{Binding IsEditingText}">
                            <TextBlock Text="Contains" Classes="muted" />
                            <TextBox Text="{Binding EditorText}" Width="240" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsChoosingField}">
                            <Button Content="Apply" Command="{Binding ApplyFilterCommand}" Classes="accent" />
                            <Button Content="Cancel" Command="{Binding CancelFilterCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- Column widths: Severity, Type and the due date have fixed widths and equal minimums, because DataGrid shrinks
             any column down to its minimum (to look empty) when the window is narrow. The text columns share the rest,
             down to a minimum, and long values end in an ellipsis. Narrower than that, the grid scrolls sideways. -->
        <DataGrid x:Name="FindingsGrid"
                  ItemsSource="{Binding Findings}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Severity" SortMemberPath="Severity" Width="104" MinWidth="104">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FindingRow">
                            <Border Classes="label" Margin="8,0"
                                    Classes.critical="{Binding IsCritical}"
                                    Classes.warning="{Binding IsWarning}"
                                    Classes.info="{Binding IsInfo}">
                                <TextBlock Text="{Binding SeverityText}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Headers for the columns below come from the check's FindingLabels (code-behind). -->
                <DataGridTextColumn SortMemberPath="ObjectDisplayName"
                                    Binding="{Binding ObjectDisplayName}" Width="2*" MinWidth="140" />
                <DataGridTextColumn SortMemberPath="UserPrincipalName"
                                    Binding="{Binding UserPrincipalName}" Width="2*" MinWidth="140" />
                <DataGridTextColumn SortMemberPath="ObjectId"
                                    Binding="{Binding ObjectId}" Width="1.5*" MinWidth="120" />
                <DataGridTextColumn SortMemberPath="SubObjectDisplayName"
                                    Binding="{Binding SubObjectDisplayName}" Width="2*" MinWidth="120" />
                <DataGridTextColumn SortMemberPath="SubObjectType"
                                    Binding="{Binding SubObjectType}" Width="112" MinWidth="112" />
                <DataGridTextColumn SortMemberPath="DueDate"
                                    Binding="{Binding DueText}" Width="140" MinWidth="140" />
                <DataGridTextColumn Header="Message" SortMemberPath="Message"
                                    Binding="{Binding Message}" Width="3*" MinWidth="160" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

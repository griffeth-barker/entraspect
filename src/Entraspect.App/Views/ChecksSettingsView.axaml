<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             xmlns:views="using:Entraspect.App.Views"
             x:Class="Entraspect.App.Views.ChecksSettingsView"
             x:DataType="vm:ChecksSettingsViewModel">
    <ScrollViewer>
        <!-- Fills the width up to a maximum, aligned left. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="820" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Checks" Classes="pageTitle" />
                <views:InfoTip Text="Scan only runs checks that are on. Changes are saved immediately. Each check lists the Microsoft Graph application permissions it needs: green when granted, red when missing. Colours show while connected." />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CheckSettingsSection">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Classes="sectionTitle" Margin="0,8,0,8" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CheckSettingsRow">
                                        <Border Padding="12" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <ItemsControl ItemsSource="{Binding Permissions}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:PermissionStatusViewModel">
                                                                <views:PermissionStatusView />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal"
                                                                IsVisible="{Binding LicencePermission, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <ContentControl Content="{Binding LicencePermission}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="vm:PermissionStatusViewModel">
                                                                    <views:PermissionStatusView />
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                        <views:InfoTip Text="{x:Static vm:PermissionStatusViewModel.LicenceToolTip}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding LicenceNote}" Classes="muted" FontSize="12"
                                                               IsVisible="{Binding !IsLicensed}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}"
                                                              IsEnabled="{Binding IsLicensed}"
                                                              OnContent="On" OffContent="Off" VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Check options" Classes="sectionTitle" Margin="0" />
                <views:InfoTip Text="Expiry windows used by the expiry checks: an item expiring within the warning window is a Warning, within the critical window a Critical. Critical must be between 0 and the warning value." />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Warning (days)" VerticalAlignment="Center" Margin="0,0,12,6" />
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ExpiryWarningDays}"
                               Minimum="0" Maximum="3650" Increment="1" FormatString="0" Width="140" Margin="0,0,0,6" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Critical (days)" VerticalAlignment="Center" Margin="0,0,12,6" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ExpiryCriticalDays}"
                               Minimum="0" Maximum="3650" Increment="1" FormatString="0" Width="140" Margin="0,0,0,6" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="New group grace (days)" VerticalAlignment="Center" Margin="0,0,12,6" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding NewGroupGraceDays}"
                               Minimum="0" Maximum="3650" Increment="1" FormatString="0" Width="140" Margin="0,0,0,6" />
                <views:InfoTip Grid.Row="2" Grid.Column="2"
                               Text="The group checks skip groups created fewer than this many days ago (UTC), so groups still being set up don't show up. 0 checks every group." />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Report-only warning (days)" VerticalAlignment="Center" Margin="0,0,12,6" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ReportOnlyWarningDays}"
                               Minimum="0" Maximum="3650" Increment="1" FormatString="0" Width="140" Margin="0,0,0,6" />
                <views:InfoTip Grid.Row="3" Grid.Column="2"
                               Text="Conditional Access policy hygiene warns about report-only policies that haven't been changed for at least this many days (UTC). 0 warns about every report-only policy." />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Sign-in lookback (days)" VerticalAlignment="Center" Margin="0,0,12,0" />
                <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding SignInLookbackDays}"
                               Minimum="1" Maximum="30" Increment="1" FormatString="0" Width="140" />
                <views:InfoTip Grid.Row="4" Grid.Column="2"
                               Text="How many days of sign-in logs the sign-in checks read, from 1 to 30. Longer periods are slower in busy tenants." />
            </Grid>
            <TextBlock Text="{Binding OptionsErrorText}" Classes="error"
                       IsVisible="{Binding OptionsErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding SaveErrorText}" Classes="error"
                       IsVisible="{Binding SaveErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

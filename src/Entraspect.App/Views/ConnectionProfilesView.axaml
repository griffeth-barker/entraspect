<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             xmlns:views="using:Entraspect.App.Views"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Entraspect.App.Views.ConnectionProfilesView"
             x:DataType="vm:ConnectionProfilesViewModel">
    <ScrollViewer>
        <!-- Fills the width up to a maximum, aligned left. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="720" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="8">
            <!-- Same width as the profile list below, so Connect's right edge lines up with the cards'. -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Text="Connection profiles" Classes="pageTitle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding AddCommand}" Classes="iconButton" VerticalAlignment="Center"
                        ToolTip.Tip="Add profile" AutomationProperties.Name="Add profile">
                    <ui:FASymbolIcon Symbol="Add" FontSize="18" />
                </Button>
                <Button Grid.Column="3" Content="Connect" Command="{Binding ConnectCommand}" Classes="accent"
                        VerticalAlignment="Center" IsVisible="{Binding ShowConnect}"
                        ToolTip.Tip="Connect with the selected profile" />
            </Grid>

            <!-- The current connection. Bound to the shell, which owns the connection. -->
            <Border DataContext="{Binding $parent[Window].DataContext}" x:DataType="vm:MainViewModel"
                    Padding="16,12" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConnectedProfileTitle}" Classes="muted"
                                       IsVisible="{Binding IsConnected}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsConnecting}" Width="120" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsConnecting}" />
                            <!-- Normally on the connected profile's card; here only when no card matches it. -->
                            <Button Content="Reconnect" Command="{Binding ReconnectCommand}"
                                    IsVisible="{Binding ShowStatusConnectionButtons}" />
                            <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                                    IsVisible="{Binding ShowStatusConnectionButtons}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ConnectionErrorText}" Classes="error"
                               IsVisible="{Binding ConnectionErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     IsEnabled="{Binding IsNotEditing}"
                     MaxHeight="360" Margin="0,8,0,0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="14,10" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="MinHeight" Value="44" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileListItem">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <!-- Only the name; the tenant and client IDs show when the profile is edited. -->
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Connected" Classes="muted" IsVisible="{Binding IsConnected}" />
                                <TextBlock Text="{x:Static vm:ConnectionProfilesViewModel.AddCertificateText}"
                                           IsVisible="{Binding NeedsCertificate}" Classes="error" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="Reconnect" Margin="0,0,4,0" IsVisible="{Binding IsConnected}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ReconnectCommand}" />
                                <Button Content="Disconnect" Margin="0,0,8,0" IsVisible="{Binding IsConnected}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DisconnectCommand}" />
                                <Button Classes="iconButton"
                                        Command="{Binding $parent[UserControl].((vm:ConnectionProfilesViewModel)DataContext).EditCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Edit profile" AutomationProperties.Name="Edit profile">
                                    <ui:FASymbolIcon Symbol="Edit" FontSize="16" />
                                </Button>
                                <Button Classes="iconButton"
                                        Command="{Binding $parent[UserControl].((vm:ConnectionProfilesViewModel)DataContext).DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Delete profile" AutomationProperties.Name="Delete profile">
                                    <ui:FASymbolIcon Symbol="Delete" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No profiles yet." Classes="muted"
                       IsVisible="{Binding HasNoProfiles}" />

            <!-- Editing profiles.json by hand, set apart from the everyday actions above. -->
            <Border Height="1" Margin="0,8" Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                    IsVisible="{Binding IsNotEditing}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsNotEditing}">
                <Button Content="Open profiles.json" Command="{Binding OpenFileCommand}" />
                <Button Content="Reload" Command="{Binding ReloadCommand}" />
                <views:InfoTip Text="Edit profiles in a text editor, save, then select Reload. entraspect saves this file whenever you change profiles here, which replaces edits you haven't reloaded, so reload first. Passwords are never saved." />
            </StackPanel>

            <Border IsVisible="{Binding IsEditing}" Padding="16" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding EditorTitle}" Classes="sectionTitle" Margin="0" />

                    <TextBlock Text="Profile name" />
                    <TextBox Text="{Binding Name}" PlaceholderText="My tenant" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tenant ID" />
                        <views:InfoTip Text="Directory (tenant) ID, or a domain such as contoso.onmicrosoft.com. Shown on the app registration's Overview page." />
                    </StackPanel>
                    <TextBox Text="{Binding TenantId}" PlaceholderText="00000000-0000-0000-0000-000000000000" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Client ID" />
                        <views:InfoTip Text="Application (client) ID of the app registration entraspect signs in as." />
                    </StackPanel>
                    <TextBox Text="{Binding ClientId}" PlaceholderText="00000000-0000-0000-0000-000000000000" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Certificate (.pfx) path" />
                        <views:InfoTip Text="A .pfx file with the certificate and private key. Its password is asked for when you connect and is never saved. Use either a .pfx file or a thumbprint." />
                    </StackPanel>
                    <TextBox Text="{Binding CertificatePath}" PlaceholderText="/path/to/cert.pfx" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Certificate thumbprint" />
                        <views:InfoTip Text="Thumbprint of a certificate in the current user's certificate store. Use either a thumbprint or a .pfx file." />
                    </StackPanel>
                    <TextBox Text="{Binding CertificateThumbprint}" PlaceholderText="ABC123..." />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusText}" Classes="muted"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding ErrorText}" Classes="error"
                       IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             x:Class="Entraspect.App.Views.ConnectionView"
             x:DataType="vm:ConnectionViewModel">
    <ScrollViewer>
        <StackPanel Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Connection profiles" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Select a saved profile or fill in the form, then use Connect in the header."
                       TextWrapping="Wrap" />

            <TextBlock Text="Saved profiles" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListBox ItemsSource="{Binding SavedProfiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     MaxHeight="180">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Profile name" Margin="0,8,0,0" />
            <TextBox Text="{Binding Name}" PlaceholderText="My tenant" />

            <TextBlock Text="Tenant ID" />
            <TextBox Text="{Binding TenantId}" PlaceholderText="00000000-0000-0000-0000-000000000000" />

            <TextBlock Text="Client ID" />
            <TextBox Text="{Binding ClientId}" PlaceholderText="00000000-0000-0000-0000-000000000000" />

            <TextBlock Text="Certificate (.pfx) path" />
            <TextBox Text="{Binding CertificatePath}" PlaceholderText="/path/to/cert.pfx" />

            <TextBlock Text="Or certificate thumbprint" />
            <TextBox Text="{Binding CertificateThumbprint}" PlaceholderText="ABC123..." />

            <TextBlock Text="Add a certificate to use this profile."
                       IsVisible="{Binding NeedsCertificate}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
            <TextBlock Text="The .pfx password is asked for when you connect and is never saved."
                       Opacity="0.7" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Save profile" Command="{Binding SaveProfileCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

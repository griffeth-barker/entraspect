<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Entraspect.App.Views.ExcessPermissionsView"
             x:DataType="vm:ExcessPermissionsViewModel">
    <StackPanel Spacing="8">
        <ui:FAInfoBar Title="Write permissions granted"
                      Message="{Binding WriteMessage}"
                      Severity="Error"
                      IsOpen="{Binding HasWritePermissions}"
                      IsVisible="{Binding HasWritePermissions}"
                      IsClosable="False" />
        <ui:FAInfoBar Title="Unused permissions"
                      Message="{Binding ReadMessage}"
                      Severity="Informational"
                      IsOpen="{Binding HasUnusedReadPermissions}"
                      IsVisible="{Binding HasUnusedReadPermissions}"
                      IsClosable="False" />
    </StackPanel>
</UserControl>

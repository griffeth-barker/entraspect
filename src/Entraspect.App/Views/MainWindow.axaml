<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Entraspect.App.ViewModels"
        xmlns:views="using:Entraspect.App.Views"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="660"
        x:Class="Entraspect.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/entraspect-icon-square.png"
        Title="Entraspect"
        Width="1240" Height="660" MinWidth="900" MinHeight="520">

    <Window.Styles>
        <!-- A slightly larger, round badge. FluentAvalonia's template gives the count a fixed bottom margin that sits
             it high, so it is moved down to the centre. -->
        <Style Selector="ui|FAInfoBadge">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MaxHeight" Value="18" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ui|FAInfoBadge /template/ TextBlock#ValueTextBlock">
            <Setter Property="RenderTransform" Value="translateY(2px)" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Child items (check pages, settings pages) have no icon. Line their text up with their section's text, like
             the Entra admin center: FluentAvalonia indents a child 31px and gives an item without an icon a 16px icon
             column, while a section's icon column is 40px (compact pane length 48 - 8), so the column becomes 9px. -->
        <Style Selector="uip|FANavigationViewItemPresenter:iconcollapsed /template/ Border#IconColumn">
            <Setter Property="Width" Value="9" />
        </Style>

        <!-- A check that failed or is missing permissions shows a warning marker instead of a count. -->
        <Style Selector="ui|FAInfoBadge.warning">
            <Setter Property="IconSource">
                <ui:FASymbolIconSource Symbol="Important" />
            </Setter>
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
    </Window.Styles>

    <ui:FANavigationView x:Name="Nav"
                         PaneDisplayMode="Left"
                         OpenPaneLength="280"
                         IsSettingsVisible="False"
                         IsBackButtonVisible="False"
                         MenuItemsSource="{Binding MenuItems}"
                         FooterMenuItemsSource="{Binding FooterItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}">
        <ui:FANavigationView.MenuItemTemplate>
            <DataTemplate x:DataType="vm:NavItemViewModel">
                <ui:FANavigationViewItem Content="{Binding Title}"
                                         IconSource="{Binding Icon, Converter={x:Static views:SymbolIconConverter.Instance}}"
                                         MenuItemsSource="{Binding Children}"
                                         IsEnabled="{Binding IsEnabled}"
                                         IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                         SelectsOnInvoked="{Binding IsPage}"
                                         ToolTip.Tip="{Binding ToolTip}"
                                         ToolTip.ShowOnDisabled="True">
                    <ui:FANavigationViewItem.InfoBadge>
                        <ui:FAInfoBadge Value="{Binding BadgeValue}"
                                        IsVisible="{Binding HasBadge}"
                                        Classes.warning="{Binding HasWarning}" />
                    </ui:FANavigationViewItem.InfoBadge>
                </ui:FANavigationViewItem>
            </DataTemplate>
        </ui:FANavigationView.MenuItemTemplate>

        <!-- No header: connection controls are on Settings > Connection profiles, the scan bar on the results pages. -->
        <ContentControl Content="{Binding CurrentPage}" Margin="16" />
    </ui:FANavigationView>

</Window>

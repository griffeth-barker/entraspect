<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Entraspect.App.ViewModels"
        xmlns:views="using:Entraspect.App.Views"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="660"
        x:Class="Entraspect.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/entraspect-icon-square.png"
        Title="Entraspect"
        Width="1240" Height="660" MinWidth="900" MinHeight="520">

    <Window.Styles>
        <!-- The navigation badges are severity pills like Overview's, so FAInfoBadge gets its own template: an optional
             gray "!" for a check without a result, then the finding count coloured by the highest severity. Its theme
             caps the height at 16, which the pills need more than. -->
        <Style Selector="ui|FAInfoBadge.navPills">
            <Setter Property="MaxHeight" Value="Infinity" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" x:DataType="vm:NavItemViewModel">
                        <Border Classes="label navPill neutral" IsVisible="{Binding HasProblem}"
                                ToolTip.Tip="{Binding ProblemToolTip}">
                            <TextBlock Text="!" />
                        </Border>
                        <Border Classes="label navPill" IsVisible="{Binding HasCount}"
                                Classes.critical="{Binding IsCritical}"
                                Classes.warning="{Binding IsWarning}"
                                Classes.info="{Binding IsInfo}"
                                ToolTip.Tip="{Binding CountToolTip}">
                            <TextBlock Text="{Binding BadgeCount}" />
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Smaller than Overview's pills, to fit the item height, and wide enough for two digits so counts line up. -->
        <Style Selector="Border.navPill">
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="MinWidth" Value="26" />
        </Style>
        <Style Selector="Border.navPill > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- An item without a chevron (a check or settings page) gets a badge column as wide as a section's chevron
             column, with the pill centred, so every pill sits on the same vertical line as the chevrons. -->
        <Style Selector="uip|FANavigationViewItemPresenter:chevronhidden /template/ ContentPresenter#InfoBadgePresenter">
            <Setter Property="MinWidth" Value="40" />
        </Style>

        <!-- Child items (check pages, settings pages) have no icon. Line their text up with their section's text, like
             the Entra admin center: FluentAvalonia indents a child 31px and gives an item without an icon a 16px icon
             column, while a section's icon column is 40px (compact pane length 48 - 8), so the column becomes 9px. -->
        <Style Selector="uip|FANavigationViewItemPresenter:iconcollapsed /template/ Border#IconColumn">
            <Setter Property="Width" Value="9" />
        </Style>

    </Window.Styles>

    <ui:FANavigationView x:Name="Nav"
                         PaneDisplayMode="Left"
                         OpenPaneLength="280"
                         IsSettingsVisible="False"
                         IsBackButtonVisible="False"
                         MenuItemsSource="{Binding MenuItems}"
                         FooterMenuItemsSource="{Binding FooterItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}">
        <ui:FANavigationView.MenuItemTemplate>
            <DataTemplate x:DataType="vm:NavItemViewModel">
                <ui:FANavigationViewItem Content="{Binding Title}"
                                         IconSource="{Binding Icon, Converter={x:Static views:SymbolIconConverter.Instance}}"
                                         MenuItemsSource="{Binding Children}"
                                         IsEnabled="{Binding IsEnabled}"
                                         IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                         SelectsOnInvoked="{Binding IsPage}"
                                         ToolTip.Tip="{Binding ToolTip}"
                                         ToolTip.ShowOnDisabled="True">
                    <ui:FANavigationViewItem.InfoBadge>
                        <ui:FAInfoBadge Classes="navPills" IsVisible="{Binding ShowBadges}" />
                    </ui:FANavigationViewItem.InfoBadge>
                </ui:FANavigationViewItem>
            </DataTemplate>
        </ui:FANavigationView.MenuItemTemplate>

        <!-- No header: connection controls are on Settings > Connection profiles, the scan bar on the results pages. -->
        <ContentControl Content="{Binding CurrentPage}" Margin="16" />
    </ui:FANavigationView>

</Window>

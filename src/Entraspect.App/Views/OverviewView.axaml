<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             x:Class="Entraspect.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
    <ScrollViewer>
        <StackPanel Spacing="8">
            <ContentControl Content="{Binding Banner}" />
            <ContentControl Content="{Binding ExcessPermissions}" />

            <TextBlock Text="Overview" Classes="pageTitle" />
            <TextBlock Text="{Binding LastScanText}" TextWrapping="Wrap" />

            <StackPanel Spacing="4" IsVisible="{Binding HasScan}">
                <Grid ColumnDefinitions="240,90,90,90" Margin="12,8,0,0">
                    <TextBlock Grid.Column="0" Text="Category" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Critical" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Warning" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Info" FontWeight="SemiBold" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategorySummary">
                            <Button Command="{Binding $parent[UserControl].((vm:OverviewViewModel)DataContext).OpenCommand}"
                                    CommandParameter="{Binding Target}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="12,6">
                                <Grid ColumnDefinitions="240,90,90,90">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" />
                                    <Border Grid.Column="1" Classes="label critical">
                                        <TextBlock Text="{Binding Critical}" />
                                    </Border>
                                    <Border Grid.Column="2" Classes="label warning">
                                        <TextBlock Text="{Binding Warning}" />
                                    </Border>
                                    <Border Grid.Column="3" Classes="label info">
                                        <TextBlock Text="{Binding Info}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding HasProblems}">
                <TextBlock Text="Checks that didn't run" Classes="sectionTitle" />
                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CheckProblem">
                            <Button Command="{Binding $parent[UserControl].((vm:OverviewViewModel)DataContext).OpenCommand}"
                                    CommandParameter="{Binding Target}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="12,6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Reason}" Classes="error" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

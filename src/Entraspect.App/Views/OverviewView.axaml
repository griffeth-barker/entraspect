<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             xmlns:views="using:Entraspect.App.Views"
             x:Class="Entraspect.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
    <ScrollViewer>
        <StackPanel Spacing="8">
            <TextBlock Text="Overview" Classes="pageTitle" />
            <views:ScanBar />

            <!-- The connected tenant. -->
            <Border IsVisible="{Binding IsConnected}" Padding="16,12" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid.Styles>
                        <Style Selector="TextBlock.key">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Margin" Value="0,2,24,2" />
                        </Style>
                        <Style Selector="SelectableTextBlock">
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </Grid.Styles>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Profile" Classes="key" />
                    <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProfileName}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tenant ID" Classes="key" />
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TenantId}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Client ID" Classes="key" />
                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClientId}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Connected" Classes="key" />
                    <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConnectedAtText}" />
                </Grid>
            </Border>

            <ContentControl Content="{Binding Banner}" />
            <ContentControl Content="{Binding ExcessPermissions}" />

            <TextBlock Text="{Binding LastScanText}" TextWrapping="Wrap" Classes="muted" Margin="0,4,0,0" />

            <StackPanel Spacing="4" IsVisible="{Binding HasScan}">
                <Grid ColumnDefinitions="240,90,90,90" Margin="12,8,0,0">
                    <TextBlock Grid.Column="0" Text="Category" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Critical" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Warning" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Info" FontWeight="SemiBold" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategorySummary">
                            <Button Command="{Binding $parent[UserControl].((vm:OverviewViewModel)DataContext).OpenCommand}"
                                    CommandParameter="{Binding Target}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="12,6"
                                    ToolTip.Tip="{Binding UnavailableReason}">
                                <!-- Gray dashes for a section the tenant's licence doesn't cover, not zeros. -->
                                <Grid ColumnDefinitions="240,90,90,90">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" />
                                    <Border Grid.Column="1" Classes="label"
                                            Classes.critical="{Binding IsAvailable}" Classes.neutral="{Binding !IsAvailable}">
                                        <TextBlock Text="{Binding CriticalText}" />
                                    </Border>
                                    <Border Grid.Column="2" Classes="label"
                                            Classes.warning="{Binding IsAvailable}" Classes.neutral="{Binding !IsAvailable}">
                                        <TextBlock Text="{Binding WarningText}" />
                                    </Border>
                                    <Border Grid.Column="3" Classes="label"
                                            Classes.info="{Binding IsAvailable}" Classes.neutral="{Binding !IsAvailable}">
                                        <TextBlock Text="{Binding InfoText}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding HasProblems}">
                <TextBlock Text="Checks that didn't run" Classes="sectionTitle" />
                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CheckProblem">
                            <Button Command="{Binding $parent[UserControl].((vm:OverviewViewModel)DataContext).OpenCommand}"
                                    CommandParameter="{Binding Target}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="12,6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Reason}" Classes="error" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

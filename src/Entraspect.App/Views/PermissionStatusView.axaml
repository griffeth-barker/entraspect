<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             x:Class="Entraspect.App.Views.PermissionStatusView"
             x:DataType="vm:PermissionStatusViewModel">
    <!-- Reused by the check page and Settings > Checks: one permission name with its granted or missing label. -->
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
        <Border Classes="label"
                Classes.granted="{Binding IsGranted}"
                Classes.critical="{Binding IsMissing}"
                IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding StatusText}" FontSize="12" />
        </Border>
    </StackPanel>
</UserControl>

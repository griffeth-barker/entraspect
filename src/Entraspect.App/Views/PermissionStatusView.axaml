<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             x:Class="Entraspect.App.Views.PermissionStatusView"
             x:DataType="vm:PermissionStatusViewModel">
    <!-- A permission name as a label: green when granted, red when missing, neutral when not connected. -->
    <Border Classes="label neutral" Margin="0,2,6,2"
            Classes.granted="{Binding IsGranted}"
            Classes.critical="{Binding IsMissing}"
            ToolTip.Tip="{Binding ToolTipText}">
        <TextBlock Text="{Binding Name}" FontSize="12" />
    </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             xmlns:views="using:Entraspect.App.Views"
             x:Class="Entraspect.App.Views.PreferencesView"
             x:DataType="vm:PreferencesViewModel">
    <ScrollViewer>
        <StackPanel Spacing="8">
            <TextBlock Text="Preferences" Classes="pageTitle" />

            <Border Padding="16,12" CornerRadius="8" BorderThickness="1" HorizontalAlignment="Left" MinWidth="420"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Show dates and times in" FontWeight="SemiBold" />
                        <views:InfoTip Text="Applies to every date and time entraspect shows, such as expiry dates and scan times. In a chosen zone, times show its UTC offset on that date." />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding TimeZoneChoices}" SelectedItem="{Binding SelectedTimeZone}"
                              MinWidth="380" MaxWidth="560" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimeZoneChoice">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding TimeZoneNotice}" Classes="muted"
                               IsVisible="{Binding TimeZoneNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Padding="16,12" CornerRadius="8" BorderThickness="1" HorizontalAlignment="Left" MinWidth="420"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}"
                              MinWidth="200" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThemeChoice">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorText}" Classes="error"
                       IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

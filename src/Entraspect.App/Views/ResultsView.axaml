<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Entraspect.App.ViewModels"
             x:Class="Entraspect.App.Views.ResultsView"
             x:DataType="vm:ResultsViewModel">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Run Scan" Command="{Binding RunScanCommand}" />
            <Button Content="Cancel" Command="{Binding RunScanCancelCommand}" />
            <Button Content="Back" Command="{Binding BackCommand}" />
            <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" />
            <ProgressBar IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Width="120" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorText}"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />

        <DataGrid ItemsSource="{Binding Findings}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" SortMemberPath="Severity"
                                    Binding="{Binding Severity}" />
                <DataGridTextColumn Header="App" SortMemberPath="ObjectDisplayName"
                                    Binding="{Binding ObjectDisplayName}" />
                <DataGridTextColumn Header="Credential" SortMemberPath="SubObjectDisplayName"
                                    Binding="{Binding SubObjectDisplayName}" />
                <DataGridTextColumn Header="Type" SortMemberPath="SubObjectType"
                                    Binding="{Binding SubObjectType}" />
                <DataGridTextColumn Header="Expires (UTC)" SortMemberPath="DueDate"
                                    Binding="{Binding DueDate, StringFormat='{}{0:yyyy-MM-dd}'}" />
                <DataGridTextColumn Header="Message" SortMemberPath="Message"
                                    Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
